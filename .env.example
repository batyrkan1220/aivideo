# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development            # development | sandbox | production

# ---- Supabase (DB, Auth, Storage) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key   # never expose to the browser

# ---- Payments (Kazakhstan gateway) ----
PAYMENT_PROVIDER=sandbox       # sandbox | kaspi ; sandbox is refused when APP_ENV=production
PAYMENT_WEBHOOK_SECRET=        # optional for sandbox (falls back to a key derived from the service key)
# Kaspi Pay (filled in after the merchant agreement; adapter in src/lib/payments/kaspi.ts)
KASPI_MERCHANT_ID=
KASPI_API_KEY=
KASPI_WEBHOOK_SECRET=
KASPI_API_BASE_URL=
# Provider callback URL to register: ${NEXT_PUBLIC_APP_URL}/api/payments/webhook/kaspi

# ---- AI video provider ----
AI_PROVIDER=dev                # dev | <real adapter key> ; dev adapter never produces fake "real" videos
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=
AI_WEBHOOK_SECRET=

# ---- Worker / queue ----
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=5000
GENERATION_MAX_ATTEMPTS=3
WORKER_SECRET=                 # ≥16 chars; protects POST /api/worker/tick (also stored in Supabase Vault for pg_cron)

# ---- Limits ----
UPLOAD_MAX_BYTES=10485760
UPLOAD_MIN_DIMENSION=256
UPLOAD_MAX_DIMENSION=8192
DAILY_PROVIDER_SPEND_LIMIT_USD=100

# ---- Retention (days) ----
UPLOAD_RETENTION_DAYS=7
VIDEO_RETENTION_DAYS=30

# ---- Monitoring ----
SENTRY_DSN=
LOG_LEVEL=info
