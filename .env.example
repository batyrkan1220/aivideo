# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development            # development | sandbox | production

# ---- Supabase (DB, Auth, Storage) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key   # never expose to the browser

# ---- Payments (Kazakhstan gateway) ----
PAYMENT_PROVIDER=sandbox       # sandbox | kaspi ; sandbox is refused when APP_ENV=production
PAYMENT_WEBHOOK_SECRET=        # optional for sandbox (falls back to a key derived from the service key)
# Kaspi Pay (filled in after the merchant agreement; adapter in src/lib/payments/kaspi.ts)
KASPI_MERCHANT_ID=
KASPI_API_KEY=
KASPI_WEBHOOK_SECRET=
KASPI_API_BASE_URL=
# Provider callback URL to register: ${NEXT_PUBLIC_APP_URL}/api/payments/webhook/kaspi

# ---- AI video provider ----
AI_PROVIDER=dev                # dev | akool ; dev adapter never produces fake "real" videos
AKOOL_API_KEY=                 # akool.com → API → API Credentials — server-only
AKOOL_API_BASE_URL=https://openapi.akool.com
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=
AI_WEBHOOK_SECRET=

# ---- Worker / queue ----
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=5000
GENERATION_MAX_ATTEMPTS=3
WORKER_SECRET=                 # ≥16 chars; protects POST /api/worker/tick (also stored in Supabase Vault for pg_cron)

# ---- Limits ----
UPLOAD_MAX_BYTES=10485760
UPLOAD_MIN_DIMENSION=256
UPLOAD_MAX_DIMENSION=8192
DAILY_PROVIDER_SPEND_LIMIT_USD=100

# ---- Retention (days) ----
UPLOAD_RETENTION_DAYS=7
VIDEO_RETENTION_DAYS=90

# ---- Monitoring ----
SENTRY_DSN=
LOG_LEVEL=info

# ── Tole Payments (Kaspi invoices) — server-only, set in Render, never commit real values ──
# PAYMENT_PROVIDER=tole_sandbox   # test: /v1/sandbox/*, needs a tole_sk_test_ key + TOLE_CONNECTION_ID
# PAYMENT_PROVIDER=tole           # live (APP_ENV=production allows only this)
TOLE_API_KEY=                     # tole_sk_... (dashboard → API keys)
TOLE_CONNECTION_ID=               # UUID of the authorised Kaspi connection (required in sandbox)
TOLE_WEBHOOK_SECRET=              # secret of the webhook endpoint you create in Tole
TOLE_API_BASE_URL=https://api.tolepay.kz/v1

# ── Telegram bot / Mini App — server-only ──
TELEGRAM_BOT_TOKEN=               # from @BotFather; then Admin → «Подключить бота»
